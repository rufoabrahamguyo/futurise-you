# ApplyVault local configuration. Copy to .env: `cp .env.example .env`.
# Every value here is safe for local development. Production values must be set
# in your deployment environment (see docs/DEPLOYMENT.md).

# --- Django ---
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DB=applyvault
POSTGRES_USER=applyvault
POSTGRES_PASSWORD=applyvault
DATABASE_URL=postgres://applyvault:applyvault@postgres:5432/applyvault

# --- Redis (Celery broker + throttling cache) ---
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Object storage (MinIO locally, any S3-compatible service in production) ---
S3_ENDPOINT_URL=http://minio:9000
# Presigned download URLs are signed for this host, which the browser must reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=applyvault-private
S3_ACCESS_KEY_ID=applyvault
S3_SECRET_ACCESS_KEY=applyvault-dev-secret
# Maximum 300 seconds.
PRESIGNED_URL_TTL_SECONDS=300

# --- Email (Mailpit locally: open http://localhost:8025) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=ApplyVault <no-reply@applyvault.local>

# --- AI ---
# fake: deterministic local provider, no key needed.
# openai_compatible: any OpenAI-compatible Chat Completions endpoint.
LLM_PROVIDER=fake
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
AI_DAILY_LIMIT=25

# --- Rate limits (count/period, e.g. 5/15m) ---
THROTTLE_LOGIN=5/15m
THROTTLE_REGISTER=10/h
THROTTLE_PASSWORD_RESET=5/h
THROTTLE_UPLOAD=60/h
THROTTLE_AI=20/h
THROTTLE_EXPORT=5/h

# --- Exports ---
EXPORT_LINK_TTL_HOURS=72

# --- Demo data (seeded on first start when SEED_DEMO=1) ---
SEED_DEMO=1
DEMO_USER_EMAIL=demo@applyvault.dev
DEMO_USER_PASSWORD=demo-password-2026
