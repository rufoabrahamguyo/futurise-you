# Production configuration. Copy to .env.production and fill in every value.
# Never commit the real file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=kazitrail.example.com
FRONTEND_URL=https://kazitrail.example.com
CSRF_TRUSTED_ORIGINS=https://kazitrail.example.com
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

POSTGRES_DB=applyvault
POSTGRES_USER=applyvault
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://applyvault:change-me@postgres:5432/applyvault

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# A private bucket. Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=eu-west-2
S3_BUCKET=kazitrail-production
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
PRESIGNED_URL_TTL_SECONDS=300
# Public origin of the storage endpoint, allowed in the frontend's Content-Security-Policy.
STORAGE_ORIGIN=https://kazitrail-production.s3.eu-west-2.amazonaws.com

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=KaziTrail <no-reply@kazitrail.example.com>

# Optional. Authorized redirect URI: {FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=25

EXPORT_LINK_TTL_HOURS=72
